<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest template. build-msix.ps1 fills in the {{...}} placeholders.

  Identity Name, Publisher, PublisherDisplayName and DisplayName must match Partner Center
  (Product identity page and the reserved app name). The defaults live in build-msix.ps1;
  the MSIX_* environment variables override them.

  Restricted capabilities (Partner Center asks you to justify each one):
  - runFullTrust: a regular desktop app.

  Deliberately NOT requested (the Store denies them, policy 10.6.3):
  - unvirtualizedResources: not needed on Windows 10 1903+ (the MinVersion below). There,
    only *new* files in AppData are redirected; deletes and edits of existing files, which
    is all Lowtide does to other apps' caches, reach the real AppData.
  - allowElevation: the Store build never elevates. shell::is_packaged() hides
    "Restart as admin", so the few system locations (Windows Temp, Windows Update,
    Delivery Optimization) are skipped. The installer and the CLI still offer them.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="{{IDENTITY_NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{DISPLAY_NAME}}</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 1903+: deletes of existing files under AppData are not virtualized. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Lowtide" Executable="Lowtide.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{DISPLAY_NAME}}"
        Description="Reclaim the disk space your dev tools quietly ate"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
